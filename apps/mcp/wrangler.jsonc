{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "scrobbler-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  // Every tool call goes to the API Worker through this binding, with the caller's own token.
  "services": [{ "binding": "API", "service": "scrobbler-api" }],
  // Serving it on your domain (e.g. scrobbler.example.com/mcp): set MCP_ROUTES in .env.cloudflare
  // (git-ignored, see .env.cloudflare.example); `vp run deploy` adds them as routes.
  // Local dev without the binding: API_ORIGIN in .dev.vars (see .dev.vars.example).
}
