{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "scrobbler-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Better Auth relies on AsyncLocalStorage and a few node: modules.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scrobbler",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db-d1/migrations",
    },
  ],
  "kv_namespaces": [{ "binding": "CACHE", "id": "00000000000000000000000000000000" }],
  // Free Cloudflare rate limiting: caps what one client can cost. namespace_id is any number unique to this Worker.
  "ratelimits": [
    { "name": "RATE_LIMIT_API", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } },
    { "name": "RATE_LIMIT_AUTH", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
  ],
  "vars": {
    // Comma-separated origins of web fronts allowed to use the auth endpoints with cookies.
    "TRUSTED_ORIGINS": "",
    "DISABLE_SIGNUP": "false",
  },
  // Real D1/KV IDs are not committed: deploy with `vp run deploy` (scripts/with-cloudflare-ids.mjs).
  // Optional var BASE_URL: public URL for Better Auth; defaults to the request origin.
  // Secret (not here): BETTER_AUTH_SECRET. Local: .dev.vars; production: wrangler secret put BETTER_AUTH_SECRET
}
