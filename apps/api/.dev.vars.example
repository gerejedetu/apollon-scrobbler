# Copy to .dev.vars for `wrangler dev`. Any long random string, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Local database: run `turso dev --db-file .turso/dev.db` (a local libSQL server), then
# `TURSO_DATABASE_URL=http://127.0.0.1:8080 vp run db:migrate` once.
TURSO_DATABASE_URL=http://127.0.0.1:8080
