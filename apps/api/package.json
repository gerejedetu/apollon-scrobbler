{
  "name": "@scrobbler/api",
  "version": "0.0.0",
  "private": true,
  "description": "ListenBrainz-compatible HTTP API (Hono) on Cloudflare Workers.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    "./testing": "./tests/helpers.ts"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "vp test && TEST_DB=libsql vp test",
    "deploy": "node scripts/with-cloudflare-ids.mjs deploy",
    "db:migrate": "vpx scripts/turso.ts migrate",
    "db:status": "vpx scripts/turso.ts status",
    "db:backfill-credits": "vpx scripts/turso.ts backfill-credits"
  },
  "dependencies": {
    "@libsql/client": "catalog:",
    "@scrobbler/auth": "workspace:*",
    "@scrobbler/cache-kv": "workspace:*",
    "@scrobbler/core": "workspace:*",
    "@scrobbler/db-d1": "workspace:*",
    "@scrobbler/db-libsql": "workspace:*",
    "@scrobbler/types": "workspace:*",
    "hono": "4.13.19"
  },
  "devDependencies": {
    "@scrobbler/testing": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "4.165.0"
  }
}
