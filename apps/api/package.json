{
  "name": "@scrobbler/api",
  "version": "0.0.0",
  "private": true,
  "description": "ListenBrainz-compatible HTTP API (Hono) on Cloudflare Workers.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vp test && TEST_DB=libsql vp test",
    "deploy": "node scripts/with-cloudflare-ids.mjs deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "node scripts/with-cloudflare-ids.mjs d1 migrations apply DB --remote",
    "db:backfill-credits:local": "vpx scripts/backfill-artist-credits.ts --local",
    "db:backfill-credits:remote": "vpx scripts/backfill-artist-credits.ts --remote"
  },
  "dependencies": {
    "@libsql/client": "catalog:",
    "@scrobbler/auth": "workspace:*",
    "@scrobbler/cache-kv": "workspace:*",
    "@scrobbler/core": "workspace:*",
    "@scrobbler/db-d1": "workspace:*",
    "@scrobbler/db-libsql": "workspace:*",
    "@scrobbler/types": "workspace:*",
    "hono": "4.13.19"
  },
  "devDependencies": {
    "@scrobbler/testing": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "4.165.0"
  }
}
